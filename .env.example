# App
NODE_ENV=development
PORT=3000
APP_NAME=DataForge

# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dataforge?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Storage (local | s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# AWS S3 (si STORAGE_DRIVER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=dataforge-files

# Upload limits
MAX_FILE_SIZE_MB=100
MAX_ROWS_PER_JOB=500000

# BullMQ
QUEUE_CONCURRENCY=5
JOB_RETRY_ATTEMPTS=3
JOB_RETRY_DELAY_MS=5000
